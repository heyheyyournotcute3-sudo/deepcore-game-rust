[
    (id: "hand_tools", name: "Hand Tools", era: 0, parents: [], cost: [], unlocks: ["workbench", "storage_crate", "research_desk", "steel_pickaxe"], description: "Chop timber, build a bench, and dig into the Shale Beds."),
    (id: "smelting", name: "Smelting", era: 1, parents: ["hand_tools"], cost: [("raw_copper", 10), ("raw_iron", 10), ("clay", 20)], unlocks: ["stone_furnace", "brick_kiln", "anvil"], description: "Fire clay into bricks and smelt your first ingots."),
    (id: "steelmaking", name: "Steelmaking", era: 1, parents: ["smelting"], cost: [("iron_ingot", 20), ("coal", 20), ("limestone", 10)], unlocks: ["blast_furnace", "hardened_pickaxe", "steel_plate"], description: "Blast iron with coal and flux into steel. Opens the Granite Depths."),
    (id: "steam_power", name: "Steam Power", era: 2, parents: ["steelmaking"], cost: [("steel_plate", 20), ("copper_pipe", 10), ("bronze_gear", 5)], unlocks: ["steam_boiler", "steam_engine", "hand_pump", "steam_drill"], description: "Boil water, drive an engine, and drill with steam."),
    (id: "ore_processing", name: "Ore Processing", era: 2, parents: ["steam_power"], cost: [("steel_plate", 24), ("bronze_gear", 8), ("copper_pipe", 12)], unlocks: ["crusher", "ore_washer"], description: "Crush and wash ore to double your ingot yield."),
    (id: "logistics", name: "Logistics", era: 2, parents: ["steam_power"], cost: [("steel_rod", 20), ("timber", 40), ("bronze_gear", 10)], unlocks: ["steel_rod", "timber_support", "steel_support"], description: "Rails, minecarts and a lift to haul ore home."),
    (id: "mine_transport", name: "Mine Transport", era: 2, parents: ["logistics"], cost: [("steel_rod", 24), ("iron_plate", 12), ("bronze_gear", 6)], unlocks: ["mine_lift", "minecart", "rail"], description: "Rails, minecarts and a powered lift to haul ore to the Base."),
    (id: "conveyor_logistics", name: "Conveyor Logistics", era: 3, parents: ["logistics"], cost: [("steel_plate", 20), ("bronze_gear", 10), ("copper_pipe", 8)], unlocks: ["conveyor", "item_pipe"], description: "Conveyors and item pipes link machines into automated lines."),
    (id: "electricity", name: "Electricity", era: 3, parents: ["ore_processing"], cost: [("steel_plate", 30), ("copper_wire", 60), ("bronze_gear", 12)], unlocks: ["steam_turbine", "generator", "battery_bank", "arc_furnace", "electrolysis_cell", "circuit_assembler", "charging_station", "electric_lamp", "module_speed"], description: "Turn steam into kilowatts and light the deep tunnels."),
    (id: "power_grid", name: "Power Grid", era: 3, parents: ["electricity"], cost: [("copper_wire", 40), ("steel_rod", 20)], unlocks: ["cable", "pole"], description: "Cables and poles carry kilowatts between machines."),
    (id: "arc_smelting", name: "Arc Smelting", era: 3, parents: ["electricity"], cost: [("steel_plate", 16), ("graphite", 10), ("copper_wire", 20)], unlocks: ["arc_furnace", "silicon"], description: "Electric arc furnaces smelt faster and reduce quartz to silicon."),
    (id: "aluminium_refining", name: "Aluminium Refining", era: 3, parents: ["arc_smelting"], cost: [("raw_bauxite", 20), ("steel_plate", 10)], unlocks: ["electrolysis_cell", "aluminium_ingot"], description: "Electrolysis turns bauxite into aluminium."),
    (id: "electronics", name: "Electronics", era: 3, parents: ["arc_smelting"], cost: [("silicon", 10), ("copper_wire", 30), ("glass", 8)], unlocks: ["circuit_assembler", "circuit_mk1"], description: "Assemble silicon and wire into circuits."),
    (id: "battery_storage", name: "Battery Storage", era: 3, parents: ["power_grid"], cost: [("lead_plate", 16), ("sulfuric_acid", 6)], unlocks: ["battery_bank", "battery_pack"], description: "Lead-acid packs buffer the grid and power portable tools."),
    (id: "deep_safety", name: "Deep Safety", era: 3, parents: ["electricity"], cost: [("steel_plate", 20), ("copper_wire", 40), ("glass", 20)], unlocks: ["vent_fan", "electric_pump", "ore_scanner", "headlamp_mk2"], description: "Vent gas, pump water, and scan for ore."),
    (id: "chemistry", name: "Chemistry", era: 4, parents: ["electricity"], cost: [("steel_plate", 30), ("glass", 20), ("copper_pipe", 20)], unlocks: ["chemical_plant", "sulfuric_acid", "fluorine_compound"], description: "Acids and fluorine compounds for the nuclear chain."),
    (id: "advanced_metallurgy", name: "Advanced Metallurgy", era: 4, parents: ["chemistry"], cost: [("steel_ingot", 40), ("nickel_ingot", 10), ("chromium_ingot", 6)], unlocks: ["alloy_furnace", "machine_shop", "stainless_steel", "tungsten_carbide", "tungsten_drill"], description: "Stainless steel and tungsten carbide. Opens the Deep Crust."),
    (id: "steel_alloys", name: "Steel Alloys", era: 4, parents: ["advanced_metallurgy"], cost: [("steel_ingot", 30), ("nickel_ingot", 8), ("chromium_ingot", 4)], unlocks: ["stainless_steel", "alloy_furnace"], description: "Nickel and chromium turn steel into stainless."),
    (id: "tungsten_tooling", name: "Tungsten Tooling", era: 4, parents: ["advanced_metallurgy"], cost: [("raw_tungsten", 12), ("graphite", 8)], unlocks: ["tungsten_carbide", "tungsten_drill"], description: "Carbide bits cut the Deep Crust."),
    (id: "chemical_feedstock", name: "Chemical Feedstock", era: 4, parents: ["chemistry"], cost: [("sulfur", 20), ("fluorite", 10), ("salt", 20)], unlocks: ["sulfuric_acid", "fluorine_compound"], description: "Bulk acids and fluorine compounds for refining."),
    (id: "hazard_gear", name: "Hazard Gear", era: 4, parents: ["advanced_metallurgy"], cost: [("steel_plate", 20), ("copper_pipe", 10), ("sealant", 10)], unlocks: ["cooling_suit", "respirator", "hazmat_suit", "geiger_counter", "decon_shower", "shielding_plate"], description: "Survive heat, gas and radiation."),
    (id: "rare_earths", name: "Rare Earths", era: 4, parents: ["advanced_metallurgy"], cost: [("monazite_sand", 20), ("sulfuric_acid", 10)], unlocks: ["rare_earth_separator", "rare_earth_magnet", "cadmium"], description: "Separate monazite into magnets; stockpile cadmium."),
    (id: "uranium_milling", name: "Uranium Milling", era: 5, parents: ["chemistry", "hazard_gear"], cost: [("sulfuric_acid", 20), ("lead_plate", 20), ("lye", 10)], unlocks: ["leaching_tank", "precipitator", "yellowcake"], description: "Crush, leach and precipitate uranium ore."),
    (id: "conversion", name: "Conversion", era: 5, parents: ["uranium_milling", "rare_earths"], cost: [("yellowcake", 10), ("fluorine_compound", 10)], unlocks: ["conversion_plant", "uf6_canister"], description: "Convert yellowcake into uranium hexafluoride."),
    (id: "enrichment", name: "Enrichment", era: 5, parents: ["conversion"], cost: [("stainless_steel", 20), ("rare_earth_magnet", 10), ("circuit_mk2", 6)], unlocks: ["centrifuge", "stainless_rotor", "enriched_canister"], description: "A centrifuge cascade enriches UF6 into reactor fuel."),
    (id: "fuel_fabrication", name: "Fuel Fabrication", era: 5, parents: ["enrichment"], cost: [("enriched_canister", 2), ("zirconium_tubing", 6)], unlocks: ["fuel_fabricator", "fuel_rod", "compact_core_cell", "nuclear_drill"], description: "Fabricate fuel rods and the compact core cell that powers the Nuclear Drill."),
    (id: "reactor_engineering", name: "Reactor Engineering", era: 5, parents: ["fuel_fabrication", "advanced_metallurgy"], cost: [("reactor_casing", 20), ("control_rod", 4), ("graphite_moderator", 10)], unlocks: ["reactor", "nuclear_drill_charger"], description: "Build a stable reactor and a scram panel."),
    (id: "reactor_console_tech", name: "Reactor Console", era: 5, parents: ["reactor_engineering"], cost: [("circuit_mk2", 4), ("glass", 10), ("steel_plate", 12)], unlocks: ["reactor_console"], description: "A console to run the reactor and watch its core temperature."),
    (id: "scram_system", name: "Scram System", era: 5, parents: ["reactor_console_tech"], cost: [("control_rod", 4), ("circuit_mk2", 3), ("steel_plate", 10)], unlocks: ["scram_panel", "control_rod"], description: "An automatic scram panel prevents a meltdown."),
    (id: "coolant_loop", name: "Coolant Loop", era: 5, parents: ["reactor_engineering"], cost: [("stainless_steel", 8), ("copper_pipe", 20), ("bearing", 4)], unlocks: ["coolant_pump", "heat_exchanger"], description: "Pump coolant through the core and recover the heat."),
    (id: "enrichment_cascade", name: "Enrichment Cascade", era: 5, parents: ["enrichment"], cost: [("stainless_rotor", 6), ("rare_earth_magnet", 12), ("circuit_mk2", 6)], unlocks: ["centrifuge", "stainless_rotor"], description: "Longer cascades enrich faster; each block adds throughput."),
    (id: "waste_handling", name: "Waste Handling", era: 5, parents: ["reactor_engineering"], cost: [("waste_cask", 4), ("lead_plate", 20)], unlocks: ["cooling_pool", "waste_vault"], description: "Cool and vault spent fuel before it poisons the Base."),
]
